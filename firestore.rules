rules_version = '2';

// SplitMate web: Cloud Firestore security rules.
// Deploy with `firebase deploy --only firestore:rules`. Tested in tests/firestore.rules.test.ts.
//
// Changes from the iOS app's rules (docs/HANDOFF.md §8 "gaps worth fixing"):
// - Emails are never stored in Firestore (they stay in Firebase Auth), so profiles are safe to search.
// - Members can only change the hangout fields the app needs, and only in the allowed direction.
// - Bills can only be created in the same write that settles their day (or ends the hangout),
//   between members of that hangout.
// - Costs must be paid by and split between members, and keep totalSpentCents in step.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ------------------------------------------------------------ Profiles
    // Public profile only (name, username, avatar, friends, privacy flag).
    match /users/{uid} {
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'username', 'friendIDs', 'showsExpenses', 'createdAt', 'avatar'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 50
          && d.username is string && d.username.matches('^[a-z0-9_.]{3,20}$')
          && d.friendIDs is list && d.friendIDs.size() <= 500
          && d.showsExpenses is bool
          && (!('avatar' in d) || d.avatar is string);
      }

      allow read: if signedIn();
      allow create: if isSelf(uid) && validProfile()
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if isSelf(uid) && validProfile()
        && request.resource.data.username == resource.data.username
        && !(uid in request.resource.data.friendIDs);
      allow delete: if false;
    }

    // One document per taken username. Readable before sign-up to check availability.
    match /usernames/{handle} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && handle.matches('^[a-z0-9_.]{3,20}$');
      allow update, delete: if false;
    }

    // Spending summary: only its owner can read it while it is hidden.
    match /publicStats/{uid} {
      allow read: if isSelf(uid) || (signedIn() && resource.data.visible == true);
      allow write: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['visible', 'totalSpentCents', 'hangoutCount', 'busiestWeekday', 'busiestMonth', 'updatedAt'])
        && request.resource.data.visible is bool;
    }

    // ------------------------------------------------------------ Join tokens
    match /hangoutTokens/{token} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.creatorID == request.auth.uid
        && token.matches('^[A-HJ-NP-Z2-9]{6}$')
        && getAfter(/databases/$(database)/documents/hangouts/$(request.resource.data.hangoutID)).data.token == token;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------ Hangouts
    match /hangouts/{hangoutID} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberIDs;
      }

      function validNew() {
        let d = request.resource.data;
        return d.creatorID == request.auth.uid
          && request.auth.uid in d.memberIDs
          && d.status == 'active'
          && d.kind in ['hangout', 'tour']
          && d.title is string && d.title.size() > 0 && d.title.size() <= 60
          && d.settledDays.size() == 0
          && d.totalSpentCents == 0
          && d.days is int && d.days >= 1 && d.days <= 30
          && d.token is string
          && d.tokenExpiresAt is timestamp
          && d.tokenExpiresAt <= request.time + duration.value(32, 'd')
          && !('endedAt' in d) && !('lastReminderAt' in d);
      }

      // A non-member may only add themselves, while the hangout is open and the token valid.
      function isJoining() {
        return signedIn()
          && !(request.auth.uid in resource.data.memberIDs)
          && resource.data.status == 'active'
          && request.time < resource.data.tokenExpiresAt
          && changed().hasOnly(['memberIDs', 'memberNames', 'memberAvatars'])
          && request.resource.data.memberIDs.hasAll(resource.data.memberIDs)
          && request.resource.data.memberIDs.size() == resource.data.memberIDs.size() + 1
          && request.auth.uid in request.resource.data.memberIDs
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('memberAvatars', {}).diff(resource.data.get('memberAvatars', {})).affectedKeys().hasOnly([request.auth.uid]);
      }

      // What a member may change, and how.
      function isMemberUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        return isMember()
          && changed().hasOnly(['totalSpentCents', 'memberNames', 'memberAvatars', 'settledDays', 'status', 'endedAt', 'lastReminderAt'])
          // Your own name and avatar only.
          && after.memberNames.diff(before.memberNames).affectedKeys().hasOnly([request.auth.uid])
          && after.get('memberAvatars', {}).diff(before.get('memberAvatars', {})).affectedKeys().hasOnly([request.auth.uid])
          // Costs only move the total while the hangout is open.
          && (!('totalSpentCents' in changed()) || (before.status == 'active' && after.totalSpentCents is int && after.totalSpentCents >= 0))
          // Settled days only grow, and only while open.
          && (!('settledDays' in changed()) || (before.status == 'active' && after.settledDays.hasAll(before.settledDays)))
          // Only the creator ends it, once, and it never reopens.
          && (!('status' in changed()) || (before.status == 'active' && after.status == 'ended' && request.auth.uid == before.creatorID && after.endedAt == request.time))
          && (!('endedAt' in changed()) || 'status' in changed())
          // Reminder rounds only after the end.
          && (!('lastReminderAt' in changed()) || (before.status == 'ended' && after.lastReminderAt == request.time));
      }

      function hangout() {
        return get(/databases/$(database)/documents/hangouts/$(hangoutID)).data;
      }

      function hangoutAfter() {
        return getAfter(/databases/$(database)/documents/hangouts/$(hangoutID)).data;
      }

      function isHangoutMember() {
        return signedIn() && request.auth.uid in hangout().memberIDs;
      }

      allow read: if isMember();
      allow create: if signedIn() && validNew();
      allow update: if isMemberUpdate() || isJoining();
      allow delete: if false;

      // Costs can't be added to an ended hangout or a settled tour day, and never edited.
      match /expenses/{expenseID} {
        function validExpense() {
          let d = request.resource.data;
          let h = hangout();
          return d.keys().hasOnly(['hangoutID', 'title', 'amountCents', 'paidByID', 'paidByName', 'splitAmongIDs', 'dayKey', 'createdAt'])
            && d.hangoutID == hangoutID
            && d.title is string && d.title.size() > 0 && d.title.size() <= 60
            && d.amountCents is int && d.amountCents > 0 && d.amountCents <= 100000000000
            && d.paidByID in h.memberIDs
            && d.splitAmongIDs is list && d.splitAmongIDs.size() > 0
            && h.memberIDs.hasAll(d.splitAmongIDs)
            && d.dayKey is string && d.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.createdAt == request.time;
        }

        allow read: if isHangoutMember();
        allow create: if isHangoutMember()
          && hangout().status == 'active'
          && !(request.resource.data.dayKey in hangout().settledDays)
          && validExpense()
          && hangoutAfter().totalSpentCents == hangout().totalSpentCents + request.resource.data.amountCents;
        allow delete: if isHangoutMember()
          && hangout().status == 'active'
          && !(resource.data.dayKey in hangout().settledDays)
          && hangoutAfter().totalSpentCents == hangout().totalSpentCents - resource.data.amountCents;
        allow update: if false;
      }

      match /notices/{noticeID} {
        allow read: if isHangoutMember();
        allow create: if isHangoutMember()
          && request.resource.data.keys().hasOnly(['message', 'forUserID', 'createdAt'])
          && request.resource.data.message is string && request.resource.data.message.size() <= 300
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------ Bills
    // Only the payer can mark a bill as sent; only the receiver can confirm it.
    match /bills/{billID} {
      function billHangoutPath() {
        return /databases/$(database)/documents/hangouts/$(request.resource.data.hangoutID);
      }

      // Created only in the same write that settles the bill's day, or ends the hangout.
      function settlesNow() {
        let before = get(billHangoutPath()).data;
        let after = getAfter(billHangoutPath()).data;
        let d = request.resource.data;
        return before.status == 'active'
          && ('dayKey' in d
            ? (before.kind == 'tour' && !(d.dayKey in before.settledDays) && d.dayKey in after.settledDays)
            : (before.kind == 'hangout' && after.status == 'ended'))
          && d.hangoutMemberIDs == before.memberIDs
          && d.fromID in before.memberIDs
          && d.toID in before.memberIDs
          && d.fromID != d.toID;
      }

      function onlyStatusChanges() {
        return changed().hasOnly(['status', 'updatedAt']) && request.resource.data.updatedAt == request.time;
      }

      allow read: if signedIn() && request.auth.uid in resource.data.hangoutMemberIDs;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.hangoutMemberIDs
        && request.resource.data.status == 'due'
        && request.resource.data.amountCents is int && request.resource.data.amountCents > 0
        && settlesNow();
      allow update: if signedIn() && onlyStatusChanges() && (
        (request.auth.uid == resource.data.fromID
          && resource.data.status == 'due'
          && request.resource.data.status == 'inProgress')
        || (request.auth.uid == resource.data.toID
          && resource.data.status in ['due', 'inProgress']
          && request.resource.data.status == 'delivered'));
      allow delete: if false;
    }
  }
}
