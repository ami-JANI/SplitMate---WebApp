# Copy to .env.local and fill in from Firebase console -> Project settings -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=splitmate-web-76056.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=splitmate-web-76056
VITE_FIREBASE_STORAGE_BUCKET=splitmate-web-76056.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to "true" to talk to the local emulators (npm run emulators) instead of the real project.
VITE_USE_EMULATORS=false
